# copy to .env (never commit it). Repos come from the App's installations.
# the GitHub App: its webhook secret, ID and private key
WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
APP_ID=1234567
APP_KEY=./app.pem
# daily caps per repo (UTC day): claude calls and dollars. Defaults 10 and 20.
#RUN_CAP=10
#USD_CAP=20
PORT=8787
# the portal: the App's OAuth client (App settings → Client ID / Generate a client secret).
# Add PUBLIC_URL/auth/callback as the App's callback URL. https:// turns on Secure cookies.
#CLIENT_ID=Iv23...
#CLIENT_SECRET=...
#PUBLIC_URL=http://127.0.0.1:8787
# serve only these of the App's repos (a local copy next to a server); unset = all
#REPOS_ONLY=owner/repo
# WORKSPACE=C:/Users/Saeed/source/repos/agent-master/work
# Linux server: run every claude call as this user, which can't read app.pem (DEPLOY.md §5b)
#RUN_AS=rookery-run

# empty = bind all interfaces (public webhook); unset = 127.0.0.1 (smee tunnel)
#HOST=
